    :vetadoParaEmbalagemPrimaria :EmbPriGeral_Ampola, :EmbPriGeral_Bombona, :EmbPriGeral_Cilindro, :EmbPriGeral_Flaconete, :EmbPriGeral_FrascoGotejador, :EmbPriGeral_Tubo ;
    :paginaDocumento 33 ;
    :paginaPDF 34 .

:FF_Pasta a owl:Class ;
    rdfs:subClassOf :Grupo_Pomada ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:unionOf (:EmbPriGeral_Bisnaga :EmbPriGeral_Pote :EmbPriGeral_Strip :EmbPriGeral_AplicadorPreenchido :EmbPriGeral_Envelope :EmbPriGeral_Lamina :EmbPriGeral_Blister :EmbPriGeral_Frasco) ] ] ,
        [ a owl:Restriction ; owl:onProperty :temRegimeLiberacao ; owl:allValuesFrom :LiberacaoImediata ] ,
        [ a owl:Restriction ; owl:onProperty :contavelFisicamente ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :esteril ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :naoDeglutir ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :exigePreparoPrevio ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :viaParenteral ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :doseUnica ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:complementOf [ a owl:Class ; owl:unionOf (:EmbPriGeral_Ampola :EmbPriGeral_Bombona :EmbPriGeral_Cilindro :EmbPriGeral_Flaconete :EmbPriGeral_FrascoGotejador :EmbPriGeral_Tubo) ] ] ] ;
    rdfs:label "Pasta (PAST)"@pt ;
    skos:prefLabel "Pasta"@pt ;
    :abreviacaoPublicacao "PAST" ;
    skos:notation "PAST" ;
    :certificacaoBPF "Pasta."@pt ;
    :conceitoLiteral "pomada contendo grande quantidade de sólidos em dispersão (pelo menos 25%)."@pt ;
    :compativelComEmbalagemPrimaria :EmbPriGeral_Bisnaga, :EmbPriGeral_Pote, :EmbPriGeral_Strip, :EmbPriGeral_AplicadorPreenchido, :EmbPriGeral_Envelope, :EmbPriGeral_Lamina, :EmbPriGeral_Blister, :EmbPriGeral_Frasco ;
    :vetadoParaEmbalagemPrimaria :EmbPriGeral_Ampola, :EmbPriGeral_Bombona, :EmbPriGeral_Cilindro, :EmbPriGeral_Flaconete, :EmbPriGeral_FrascoGotejador, :EmbPriGeral_Tubo ;
    :paginaDocumento 33 ;
    :paginaPDF 34 .

:FF_Gas a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaGasosa ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:unionOf (:EmbPriGeral_Cilindro) ] ] ,
