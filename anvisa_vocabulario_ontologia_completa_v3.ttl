    :paginaDocumento 33 ;
    :paginaPDF 34 .

# ==============================================================================
# 7. EMBALAGENS E ACESSÓRIOS (COM RESTRIÇÕES OWL 2 DL allValuesFrom/hasValue)
# ==============================================================================
:Embalagem a owl:Class ; rdfs:subClassOf :ElementoAcondicionamento ; rdfs:label "Embalagem"@pt ; :paginaDocumento 9 .
:EmbalagemPrimaria a owl:Class ;
    rdfs:subClassOf :Embalagem ,
        [ a owl:Restriction ; owl:onProperty :emContatoDiretoCom ; owl:allValuesFrom :FormaFarmaceutica ] ;
    rdfs:label "Embalagem Primária"@pt ; :paginaDocumento 9 .

:EnvoltorioIntermediario a owl:Class ;
    rdfs:subClassOf :Embalagem ,
        [ a owl:Restriction ; owl:onProperty :envolveEmbalagemPrimaria ; owl:allValuesFrom :EmbalagemPrimaria ] ;
    rdfs:label "Envoltório Intermediário"@pt ; :paginaDocumento 9 .

:EmbalagemSecundaria a owl:Class ;
    rdfs:subClassOf :Embalagem ,
        [ a owl:Restriction ; owl:onProperty :contemAcondicionamento ; owl:allValuesFrom [ a owl:Class ; owl:unionOf (:EmbalagemPrimaria :EnvoltorioIntermediario) ] ] ;
    rdfs:label "Embalagem Secundária"@pt ; :paginaDocumento 9 .

:Acessorio a owl:Class ;
    rdfs:subClassOf :ElementoAcondicionamento ,
        [ a owl:Restriction ; owl:onProperty :comercializadoDentroDe ; owl:allValuesFrom :EmbalagemSecundaria ] ,
        [ a owl:Restriction ; owl:onProperty :emContatoDiretoCom ; owl:allValuesFrom owl:Nothing ] ;
    rdfs:label "Acessório"@pt ; :paginaDocumento 9 .
[] a owl:AllDisjointClasses ; owl:members (:EmbalagemPrimaria :EnvoltorioIntermediario :EmbalagemSecundaria :Acessorio) .

:EmbPriGeral_Ampola a owl:Class ;
    rdfs:subClassOf :EmbalagemPrimaria ,
        [ a owl:Restriction ; owl:onProperty :acondicionaForma ; owl:allValuesFrom [ a owl:Class ; owl:intersectionOf (:FormaFarmaceuticaLiquida [ a owl:Restriction ; owl:onProperty :esteril ; owl:hasValue true ] [ a owl:Restriction ; owl:onProperty :viaParenteral ; owl:hasValue true ] [ a owl:Restriction ; owl:onProperty :doseUnica ; owl:hasValue true ]) ] ] ;
    rdfs:label "Ampola"@pt ;
    skos:prefLabel "Ampola"@pt ;
    :conceitoLiteral "recipiente fechado hermeticamente, destinado ao armazenamento de líquidos estéreis para uso por via parenteral e cujo conteúdo é utilizado em dose única."@pt ;
    :paginaDocumento 37 ;
    :paginaPDF 38 .

:EmbPri_AmpolaDePlasticoTranslucido a owl:Class ;
    rdfs:subClassOf :EmbPriGeral_Ampola , [ a owl:Restriction ; owl:onProperty :sistemaFechado ; owl:hasValue false ] , [ a owl:Restriction ; owl:onProperty :temMaterialContatoInterno ; owl:allValuesFrom :MaterialPlastico ] , [ a owl:Restriction ; owl:onProperty :temMaterialContatoExterno ; owl:allValuesFrom :MaterialPlastico ] , [ a owl:Restriction ; owl:onProperty :temGrauTransparencia ; owl:allValuesFrom :TransparenciaTranslucido ] ;
    rdfs:label "Ampola de plástico translúcido (AMP PLAS TRANSL)"@pt ;
    skos:prefLabel "Ampola de plástico translúcido"@pt ;
    :abreviacaoPublicacao "AMP PLAS TRANSL" ;
    skos:notation "AMP PLAS TRANSL" ;
    :abreviacaoLiteralOriginal "AMP PLAS TRANSL]" ;
    :anomaliaTipograficaOficial "Colchete fechado ']' impresso ao final da abreviação na pág. 37."@pt ;
    :paginaDocumento 37 ;
    :paginaPDF 38 .

