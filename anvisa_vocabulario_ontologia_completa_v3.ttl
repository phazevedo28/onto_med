@prefix : <https://anvisa.gov.br/ontologia/vocabulario-controlado#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://anvisa.gov.br/ontologia/vocabulario-controlado> a owl:Ontology ;
    rdfs:label "Ontologia do Vocabulário Controlado da Anvisa (v3 - Árvore Limpa + Restrições Formais OWL 2 DL)"@pt ;
    owl:versionInfo "3.0.0-dl-complete-clean-tree" ;
    rdfs:comment "Versão v3 que une o melhor dos dois mundos: (1) Árvore rdfs:subClassOf estritamente limpa (1 único pai nomeado por classe, sem duplicação de formas farmacêuticas e sem setas azuis invertidas de someValuesFrom) e (2) 100% das restrições formais OWL 2 DL (owl:Restriction com owl:allValuesFrom, owl:complementOf e owl:hasValue) ativas para Reasoners (HermiT/Pellet/ELK), além das anotações diretas para consultas SPARQL rápidas."@pt .

# ==============================================================================
# 1. PROPRIEDADES DE ANOTAÇÃO E ATALHOS SPARQL
# ==============================================================================
:abreviacaoPublicacao a owl:AnnotationProperty ;
    rdfs:label "Abreviação para publicação"@pt .

:abreviacaoLiteralOriginal a owl:AnnotationProperty ;
    rdfs:label "Abreviação literal impressa no documento original"@pt .

:anomaliaTipograficaOficial a owl:AnnotationProperty ;
    rdfs:label "Anomalia tipográfica oficial"@pt .

:certificacaoBPF a owl:AnnotationProperty ;
    rdfs:label "Para fins de certificação em BPF"@pt .

:conceitoLiteral a owl:AnnotationProperty ;
    rdfs:label "Conceito literal no Vocabulário Controlado"@pt .

:paginaDocumento a owl:AnnotationProperty ;
    rdfs:label "Página impressa no documento oficial"@pt .

:paginaPDF a owl:AnnotationProperty ;
    rdfs:label "Página no arquivo PDF"@pt .

:secaoDocumento a owl:AnnotationProperty ;
    rdfs:label "Seção do documento oficial"@pt .

:regraDSL a owl:AnnotationProperty ;
    rdfs:label "Expressão lógica IF-THEN (DSL)"@pt .

:categoriaRegra a owl:AnnotationProperty ;
    rdfs:label "Categoria da regra auditável"@pt .

:citacaoLiteralAuditoria a owl:AnnotationProperty ;
    rdfs:label "Citação literal para auditoria"@pt .

:compativelComEmbalagemPrimaria a owl:AnnotationProperty ;
    rdfs:label "Atalho SPARQL: Embalagem primária compatível"@pt .

:vetadoParaEmbalagemPrimaria a owl:AnnotationProperty ;
    rdfs:label "Atalho SPARQL: Embalagem primária vetada"@pt .

:acondicionaEstadoFisico a owl:AnnotationProperty ;
    rdfs:label "Atalho SPARQL: Estado físico acondicionado"@pt .

# ==============================================================================
# 2. PROPRIEDADES DE OBJETO OWL 2 DL (USADAS PELO REASONER NAS RESTRIÇÕES)
# ==============================================================================
:acondicionaForma a owl:ObjectProperty ;
    rdfs:label "acondiciona forma farmacêutica"@pt ;
    rdfs:domain :EmbalagemPrimaria ;
    rdfs:range :FormaFarmaceutica ;
    .

:acondicionadaEmEmbalagemPrimaria a owl:ObjectProperty ;
    rdfs:label "é acondicionada em embalagem primária"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range :EmbalagemPrimaria ;
    owl:inverseOf :acondicionaForma ;
    .

:emContatoDiretoCom a owl:ObjectProperty ;
    rdfs:label "mantém contato direto com"@pt ;
    rdfs:domain :EmbalagemPrimaria ;
    rdfs:range :FormaFarmaceutica ;
    .

:envolveEmbalagemPrimaria a owl:ObjectProperty ;
    rdfs:label "envolve embalagem primária"@pt ;
    rdfs:domain :EnvoltorioIntermediario ;
    rdfs:range :EmbalagemPrimaria ;
    .

:contemAcondicionamento a owl:ObjectProperty ;
    rdfs:label "contém embalagem primária ou envoltório intermediário"@pt ;
    rdfs:domain :EmbalagemSecundaria ;
    rdfs:range :Embalagem ;
    .

:comercializadoDentroDe a owl:ObjectProperty ;
    rdfs:label "é comercializado dentro de"@pt ;
    rdfs:domain :Acessorio ;
    rdfs:range :EmbalagemSecundaria ;
    .

:acopladoA a owl:ObjectProperty ;
    rdfs:label "é acoplado ou conectado a"@pt ;
    rdfs:domain :ElementoAcondicionamento ;
    rdfs:range :ElementoAcondicionamento ;
    .

:temMaterialContatoInterno a owl:ObjectProperty ;
    rdfs:label "tem material em contato com a forma farmacêutica (1º material)"@pt ;
    rdfs:domain :EmbalagemPrimaria ;
    rdfs:range :MaterialComposicao ;
    .

:temMaterialContatoExterno a owl:ObjectProperty ;
    rdfs:label "tem material em contato com o meio externo (2º material)"@pt ;
    rdfs:domain :EmbalagemPrimaria ;
    rdfs:range :MaterialComposicao ;
    .

:temGrauTransparencia a owl:ObjectProperty ;
    rdfs:label "tem grau de transparência"@pt ;
    rdfs:domain :EmbalagemPrimaria ;
    rdfs:range :GrauTransparencia ;
    .

:temRegimeLiberacao a owl:ObjectProperty ;
    rdfs:label "tem regime de liberação"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range :RegimeLiberacao ;
    .

:transformaSeAposPreparoEm a owl:ObjectProperty ;
    rdfs:label "transforma-se após preparo prévio em"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range :FormaFarmaceutica ;
    .

# ==============================================================================
# 3. PROPRIEDADES DE DADOS OWL 2 DL (ATRIBUTOS BOOLEANOS E LIMIARES NUMÉRICOS)
# ==============================================================================
:contavelFisicamente a owl:DatatypeProperty ;
    rdfs:label "é fisicamente contável em unidades discretas"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:boolean .

:esteril a owl:DatatypeProperty ;
    rdfs:label "é estéril"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:boolean .

:naoDeglutir a owl:DatatypeProperty ;
    rdfs:label "proibida deglutição (não deve ser deglutido)"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:boolean .

:exigePreparoPrevio a owl:DatatypeProperty ;
    rdfs:label "exige dissolução, dispersão, reconstituição ou diluição prévia"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:boolean .

:doseUnica a owl:DatatypeProperty ;
    rdfs:label "apresentada em dose única"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:boolean .

:viaParenteral a owl:DatatypeProperty ;
    rdfs:label "administrada por via parenteral"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:boolean .

:sistemaFechado a owl:DatatypeProperty ;
    rdfs:label "opera em sistema fechado"@pt ;
    rdfs:domain :EmbalagemPrimaria ;
    rdfs:range xsd:boolean .

:barreiraProtecaoLuminosidade a owl:DatatypeProperty ;
    rdfs:label "constitui barreira de proteção à luminosidade"@pt ;
    rdfs:domain :GrauTransparencia ;
    rdfs:range xsd:boolean .

:teorAlcoolMinimoExclusivoPercentual a owl:DatatypeProperty ;
    rdfs:label "teor de álcool mínimo exclusivo (%)"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:decimal .

:diametroMinimoExclusivoMM a owl:DatatypeProperty ;
    rdfs:label "diâmetro mínimo exclusivo de granulometria (mm)"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:decimal .

:teorAcucaresMinimoInclusivoPercentual a owl:DatatypeProperty ;
    rdfs:label "teor mínimo inclusivo de sacarose ou outros açúcares (%)"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:decimal .

:teorSolidosMinimoInclusivoPercentual a owl:DatatypeProperty ;
    rdfs:label "teor mínimo inclusivo de sólidos em dispersão (%)"@pt ;
    rdfs:domain :FormaFarmaceutica ;
    rdfs:range xsd:decimal .

# ==============================================================================
# 4. EIXOS TAXONÔMICOS DE TOPO (DISJUNTOS)
# ==============================================================================
:FormaFarmaceutica a owl:Class ; rdfs:label "1. Forma Farmacêutica"@pt ; :paginaDocumento 9 .
:ElementoAcondicionamento a owl:Class ; rdfs:label "2. Embalagens e Acessórios"@pt .
:ViaAdministracao a owl:Class ; rdfs:label "3. Via de Administração"@pt ; :paginaDocumento 11 .
:AtributoPadronizacao a owl:Class ; rdfs:label "4. Atributos de Padronização (Material, Transparência e Liberação)"@pt .
[] a owl:AllDisjointClasses ; owl:members (:FormaFarmaceutica :ElementoAcondicionamento :ViaAdministracao :AtributoPadronizacao) .

:MaterialComposicao a owl:Class ; rdfs:subClassOf :AtributoPadronizacao ; rdfs:label "Material de Composição"@pt .
:MaterialAluminio a owl:Class ; rdfs:subClassOf :MaterialComposicao ; rdfs:label "Alumínio (AL)"@pt ; :abreviacaoPublicacao "AL" .
:MaterialPlastico a owl:Class ; rdfs:subClassOf :MaterialComposicao ; rdfs:label "Plástico (PLAS)"@pt ; :abreviacaoPublicacao "PLAS" .
:MaterialVidro a owl:Class ; rdfs:subClassOf :MaterialComposicao ; rdfs:label "Vidro (VD)"@pt ; :abreviacaoPublicacao "VD" .
:MaterialPapel a owl:Class ; rdfs:subClassOf :MaterialComposicao ; rdfs:label "Papel (PAP)"@pt ; :abreviacaoPublicacao "PAP" .
:MaterialMetal a owl:Class ; rdfs:subClassOf :MaterialComposicao ; rdfs:label "Metal (MET)"@pt ; :abreviacaoPublicacao "MET" .
:GrauTransparencia a owl:Class ; rdfs:subClassOf :AtributoPadronizacao ; rdfs:label "Grau de Transparência"@pt .
:TransparenciaAmbar a owl:Class ; rdfs:subClassOf :GrauTransparencia , [ a owl:Restriction ; owl:onProperty :barreiraProtecaoLuminosidade ; owl:hasValue true ] ; rdfs:label "Âmbar (AMB)"@pt ; :abreviacaoPublicacao "AMB" .
:TransparenciaOpaco a owl:Class ; rdfs:subClassOf :GrauTransparencia , [ a owl:Restriction ; owl:onProperty :barreiraProtecaoLuminosidade ; owl:hasValue true ] ; rdfs:label "Opaco (OPC)"@pt ; :abreviacaoPublicacao "OPC" .
:TransparenciaTranslucido a owl:Class ; rdfs:subClassOf :GrauTransparencia , [ a owl:Restriction ; owl:onProperty :barreiraProtecaoLuminosidade ; owl:hasValue false ] ; rdfs:label "Translúcido (TRANSL)"@pt ; :abreviacaoPublicacao "TRANSL" .
:TransparenciaTransparente a owl:Class ; rdfs:subClassOf :GrauTransparencia , [ a owl:Restriction ; owl:onProperty :barreiraProtecaoLuminosidade ; owl:hasValue false ] ; rdfs:label "Transparente (TRANS)"@pt ; :abreviacaoPublicacao "TRANS" .
:RegimeLiberacao a owl:Class ; rdfs:subClassOf :AtributoPadronizacao ; rdfs:label "Regime de Liberação"@pt .
:LiberacaoImediata a owl:Class ; rdfs:subClassOf :RegimeLiberacao ; rdfs:label "Liberação imediata"@pt .
:LiberacaoModificada a owl:Class ; rdfs:subClassOf :RegimeLiberacao ; rdfs:label "Liberação modificada (LIB MOD)"@pt .
:LiberacaoProlongada a owl:Class ; rdfs:subClassOf :LiberacaoModificada ; rdfs:label "Liberação prolongada (LIB PROL)"@pt .
:LiberacaoRetardada a owl:Class ; rdfs:subClassOf :LiberacaoModificada ; rdfs:label "Liberação retardada / Gastrorresistente (LIB RETARD)"@pt .

# ==============================================================================
# 6. FORMAS FARMACÊUTICAS (ÁRVORE LIMPA + RESTRIÇÕES OWL 2 DL allValuesFrom/hasValue)
# ==============================================================================
:FormaFarmaceuticaSolida a owl:Class ; rdfs:subClassOf :FormaFarmaceutica ; rdfs:label "Forma Farmacêutica Sólida"@pt ; skos:prefLabel "Forma Farmacêutica Sólida"@pt ; :paginaDocumento 13 .
:FormaFarmaceuticaLiquida a owl:Class ; rdfs:subClassOf :FormaFarmaceutica ; rdfs:label "Forma Farmacêutica Líquida"@pt ; skos:prefLabel "Forma Farmacêutica Líquida"@pt ; :paginaDocumento 25 .
:FormaFarmaceuticaSemiSolida a owl:Class ; rdfs:subClassOf :FormaFarmaceutica ; rdfs:label "Forma Farmacêutica Semi-Sólida"@pt ; skos:prefLabel "Forma Farmacêutica Semi-Sólida"@pt ; :paginaDocumento 32 .
:FormaFarmaceuticaGasosa a owl:Class ; rdfs:subClassOf :FormaFarmaceutica ; rdfs:label "Forma Farmacêutica Gasosa"@pt ; skos:prefLabel "Forma Farmacêutica Gasosa"@pt ; :paginaDocumento 33 .
[] a owl:AllDisjointClasses ; owl:members (:FormaFarmaceuticaSolida :FormaFarmaceuticaLiquida :FormaFarmaceuticaSemiSolida :FormaFarmaceuticaGasosa) .

:Grupo_Capsula a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ;
    rdfs:label "Grupo: Cápsula (Forma Básica)"@pt ;
    skos:prefLabel "Cápsula (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica sólida na qual o(s) princípio(s) ativo(s) e/ou os excipientes estão contidos em invólucro solúvel duro ou mole, de formatos e tamanhos variados, usualmente contendo uma dose única do princípio ativo. Normalmente é formada de gelatina, mas pode também ser de amido ou de outras substâncias."@pt ;
    :paginaDocumento 13 ;
    :paginaPDF 14 .

:Grupo_Comprimido a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ;
    rdfs:label "Grupo: Comprimido (Forma Básica)"@pt ;
    skos:prefLabel "Comprimido (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica sólida contendo uma dose única de um ou mais princípios ativos, com ou sem excipientes, obtida pela compressão de volumes uniformes de partículas. Pode ser de uma ampla variedade de tamanhos e formatos, apresentar marcações na superfície e ser revestido ou não."@pt ;
    :paginaDocumento 15 ;
    :paginaPDF 16 .

:Grupo_Granulado a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ;
    rdfs:label "Grupo: Granulado (Forma Básica)"@pt ;
    skos:prefLabel "Granulado (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica sólida contendo uma dose única de um ou mais princípios ativos, com ou sem excipientes. Consiste de agregados sólidos e secos de volumes uniformes de partículas de pó resistentes ao manuseio."@pt ;
    :paginaDocumento 18 ;
    :paginaPDF 19 .

:Grupo_Pastilha a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ;
    rdfs:label "Grupo: Pastilha (Forma Básica)"@pt ;
    skos:prefLabel "Pastilha (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica sólida que contém um ou mais princípios ativos, usualmente em uma base adocicada e com sabor agradável. É utilizada para dissolução ou desintegração lenta na boca. Pode ser preparada por moldagem ou por compressão."@pt ;
    :paginaDocumento 20 ;
    :paginaPDF 21 .

:Grupo_Po a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ;
    rdfs:label "Grupo: Pó (Forma Básica)"@pt ;
    skos:prefLabel "Pó (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica sólida contendo um ou mais princípios ativos secos e com tamanho de partícula reduzido, com ou sem excipientes."@pt ;
    :paginaDocumento 21 ;
    :paginaPDF 22 .

:Grupo_Supositorio a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ;
    rdfs:label "Grupo: Supositório (Forma Básica)"@pt ;
    skos:prefLabel "Supositório (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica sólida de vários tamanhos e formatos, adaptada para introdução no orifício retal, vaginal ou uretral do corpo humano, contendo um ou mais princípios ativos dissolvidos ou dispersos numa base adequada. Os supositórios fundem-se, derretem ou dissolvem na temperatura do corpo."@pt ;
    :paginaDocumento 24 ;
    :paginaPDF 25 .

:Grupo_Emulsao a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaLiquida ;
    rdfs:label "Grupo: Emulsão (Forma Básica)"@pt ;
    skos:prefLabel "Emulsão (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica líquida de um ou mais princípios ativos que consiste de um sistema de duas fases que envolvem pelo menos dois líquidos imiscíveis e na qual um líquido é disperso na forma de pequenas gotas (fase interna ou dispersa) através de outro líquido (fase externa ou contínua). Normalmente é estabilizada através de um ou mais agentes emulsificantes."@pt ;
    :paginaDocumento 25 ;
    :paginaPDF 26 .

:Grupo_Liquido a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaLiquida ;
    rdfs:label "Grupo: Líquido (Forma Básica)"@pt ;
    skos:prefLabel "Líquido (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica que consiste de uma substância química pura no estado líquido, podendo ser aquosa ou oleosa. Obs.: esta forma farmacêutica não deve ser aplicada para soluções, suspensões, emulsões, xampus e sabonetes líquidos."@pt ;
    :paginaDocumento 26 ;
    :paginaPDF 27 .

:Grupo_Solucao a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaLiquida ;
    rdfs:label "Grupo: Solução (Forma Básica)"@pt ;
    skos:prefLabel "Solução (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica líquida límpida e homogênea, que contém um ou mais princípios ativos dissolvidos em um solvente adequado ou numa mistura de solventes miscíveis."@pt ;
    :paginaDocumento 27 ;
    :paginaPDF 28 .

:Grupo_Suspensao a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaLiquida ;
    rdfs:label "Grupo: Suspensão (Forma Básica)"@pt ;
    skos:prefLabel "Suspensão (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica líquida que contém partículas sólidas dispersas em um veículo líquido, no qual as partículas não são solúveis."@pt ;
    :paginaDocumento 30 ;
    :paginaPDF 31 .

:Grupo_Pomada a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSemiSolida ;
    rdfs:label "Grupo: Pomada (Forma Básica)"@pt ;
    skos:prefLabel "Pomada (Forma Básica)"@pt ;
    :conceitoLiteral "forma farmacêutica semi-sólida para aplicação na pele ou nas membranas mucosas, que consiste de solução ou dispersão de um ou mais princípios ativos em baixas proporções em uma base adequada."@pt ;
    :paginaDocumento 33 ;
    :paginaPDF 34 .

:FF_Adesivo a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:unionOf (:EmbPriGeral_Pote :EmbPriGeral_Strip :EmbPriGeral_Tubo :EmbPriGeral_Blister :EmbPriGeral_Envelope :EmbPriGeral_Frasco :EmbPriGeral_Estojo :EmbPriGeral_Lamina) ] ] ,
        [ a owl:Restriction ; owl:onProperty :temRegimeLiberacao ; owl:allValuesFrom :LiberacaoProlongada ] ,
        [ a owl:Restriction ; owl:onProperty :contavelFisicamente ; owl:hasValue true ] ,
        [ a owl:Restriction ; owl:onProperty :esteril ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :naoDeglutir ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :exigePreparoPrevio ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :viaParenteral ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :doseUnica ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:complementOf [ a owl:Class ; owl:unionOf (:EmbPriGeral_Ampola :EmbPriGeral_Bisnaga :EmbPriGeral_Bombona :EmbPriGeral_Cilindro :EmbPriGeral_Flaconete :EmbPriGeral_FrascoGotejador) ] ] ] ;
    rdfs:label "Adesivo (ADES)"@pt ;
    skos:prefLabel "Adesivo"@pt ;
    :abreviacaoPublicacao "ADES" ;
    skos:notation "ADES" ;
    :certificacaoBPF "Adesivo."@pt ;
    :conceitoLiteral "sistema destinado a produzir um efeito sistêmico pela difusão do(s) princípio(s) ativo(s) numa velocidade constante, por um período de tempo prolongado."@pt ;
    :compativelComEmbalagemPrimaria :EmbPriGeral_Pote, :EmbPriGeral_Strip, :EmbPriGeral_Tubo, :EmbPriGeral_Blister, :EmbPriGeral_Envelope, :EmbPriGeral_Frasco, :EmbPriGeral_Estojo, :EmbPriGeral_Lamina ;
    :vetadoParaEmbalagemPrimaria :EmbPriGeral_Ampola, :EmbPriGeral_Bisnaga, :EmbPriGeral_Bombona, :EmbPriGeral_Cilindro, :EmbPriGeral_Flaconete, :EmbPriGeral_FrascoGotejador ;
    :paginaDocumento 13 ;
    :paginaPDF 14 .

:FF_Anel a owl:Class ;
    rdfs:subClassOf :FormaFarmaceuticaSolida ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:unionOf (:EmbPriGeral_Pote :EmbPriGeral_Strip :EmbPriGeral_Tubo :EmbPriGeral_Blister :EmbPriGeral_Envelope :EmbPriGeral_Frasco :EmbPriGeral_Estojo :EmbPriGeral_Lamina) ] ] ,
        [ a owl:Restriction ; owl:onProperty :temRegimeLiberacao ; owl:allValuesFrom :LiberacaoProlongada ] ,
        [ a owl:Restriction ; owl:onProperty :contavelFisicamente ; owl:hasValue true ] ,
        [ a owl:Restriction ; owl:onProperty :esteril ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :naoDeglutir ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :exigePreparoPrevio ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :viaParenteral ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :doseUnica ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:complementOf [ a owl:Class ; owl:unionOf (:EmbPriGeral_Ampola :EmbPriGeral_Bisnaga :EmbPriGeral_Bombona :EmbPriGeral_Cilindro :EmbPriGeral_Flaconete :EmbPriGeral_FrascoGotejador) ] ] ] ;
    rdfs:label "Anel (ANEL)"@pt ;
    skos:prefLabel "Anel"@pt ;
    :abreviacaoPublicacao "ANEL" ;
    skos:notation "ANEL" ;
    :certificacaoBPF "Anel."@pt ;
    :conceitoLiteral "forma farmacêutica circular sólida destinada à liberação do princípio ativo a uma velocidade constante, por um período de tempo prolongado."@pt ;
    :compativelComEmbalagemPrimaria :EmbPriGeral_Pote, :EmbPriGeral_Strip, :EmbPriGeral_Tubo, :EmbPriGeral_Blister, :EmbPriGeral_Envelope, :EmbPriGeral_Frasco, :EmbPriGeral_Estojo, :EmbPriGeral_Lamina ;
    :vetadoParaEmbalagemPrimaria :EmbPriGeral_Ampola, :EmbPriGeral_Bisnaga, :EmbPriGeral_Bombona, :EmbPriGeral_Cilindro, :EmbPriGeral_Flaconete, :EmbPriGeral_FrascoGotejador ;
