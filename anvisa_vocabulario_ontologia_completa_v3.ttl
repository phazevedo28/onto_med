        [ a owl:Restriction ; owl:onProperty :exigePreparoPrevio ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :viaParenteral ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :doseUnica ; owl:hasValue false ] ,
        [ a owl:Restriction ; owl:onProperty :acondicionadaEmEmbalagemPrimaria ; owl:allValuesFrom [ a owl:Class ; owl:complementOf [ a owl:Class ; owl:unionOf (:EmbPriGeral_Ampola :EmbPriGeral_Bisnaga :EmbPriGeral_Bombona :EmbPriGeral_Flaconete :EmbPriGeral_FrascoGotejador :EmbPriGeral_Pote :EmbPriGeral_Strip :EmbPriGeral_Tubo) ] ] ] ;
